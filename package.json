{
  "name": "squadra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:local": "node scripts/test-local.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/tipos-do-banco.ts && prettier --write lib/supabase/tipos-do-banco.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/analytics": "2.0.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.454.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^1.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-boundaries": "^7.4.5",
    "happy-dom": "^21.0.4",
    "pg": "^8.23.1",
    "postcss": "^8.5.15",
    "prettier": "3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
